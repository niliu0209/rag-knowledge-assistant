# 复制为 .env 后按需修改（.env 不入 Git）
# 数据目录：SQLite/Chroma/上传文件统一存放（容器内固定 /data）
DATA_DIR=./data
# API 服务
API_HOST=0.0.0.0
API_PORT=8000
# UI 服务访问 API 的地址（容器内为 http://api:8000）
API_URL=http://localhost:8000
UI_PORT=8501
# 日志级别
LOG_LEVEL=INFO
# S1-2 Key 加密主密钥（Fernet 密钥，32 字节 url-safe base64）
# 生成：python -c "from app.core.crypto import generate_key; print(generate_key())"
# 未设置时自动生成并持久化到 data_dir/secrets/rag_key.bin（0600，不入 Git）
RAG_KEY_ENCRYPTION_KEY=
# 保管提示：此密钥丢失或被替换后，已保存的 API Key 将无法解密（迁移前备份
# data/rag.db.pre-v003-*.bak 为唯一回滚路径）；建议复制到密码管理器留存。
# S2-2 平台共享免费预设 Key（可选）：配置后 preset 模式用户无需自备 Key 即可
# 使用免费预设额度（回落此 Key）；不配置则免费预设对无 Key 用户不可用。
# 不入库、不写日志、不在界面回显（含掩码）。
RAG_SHARED_PRESET_KEY=
